# Copia este archivo como .env antes de ejecutar:  cp .env.example .env
# Nunca pongas llaves reales en archivos versionados.

# --- Backend (Docker Compose) ---
PORT=8000
CORS_ORIGIN=http://localhost:8080

# --- Base de datos: emulador de Firestore (servicio "db") ---
FIREBASE_PROJECT_ID=demo-refricaz
FIRESTORE_EMULATOR_HOST=db:8081

# --- Opcionales: funciones serverless de api/ (chat IA y leads) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Ejemplo: http://localhost:3000,https://refricaz.com
ALLOWED_ORIGINS=
# Webhook temporal para leads (SheetDB, Zapier o Make)
LEADS_WEBHOOK_URL=
