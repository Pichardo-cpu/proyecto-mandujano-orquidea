FROM node:22-trixie-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-21-jre-headless curl \
 && rm -rf /var/lib/apt/lists/*
# IMPORTANTE: cambia VERSION por la versión actual (npm view firebase-tools version)
RUN npm install -g firebase-tools@VERSION \
 && firebase setup:emulators:firestore
WORKDIR /app
COPY firebase.json .
EXPOSE 8081
CMD ["sh", "-c", "if [ -f /data/firebase-export-metadata.json ]; then I='--import=/data'; fi; exec firebase emulators:start --only firestore --project demo-refricaz $I --export-on-exit=/data"]
