# Práctica P2 - configuración local reproducible (SIN secretos reales).
# 1. Copiar este archivo a .env en la raiz.
# 2. Ejecutar: docker compose up --build
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
FIREBASE_PROJECT_ID=demo-refricaz
FIRESTORE_EMULATOR_HOST=firestore:8080
# Opcionales. No son necesarios para probar la API con Swagger.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ALLOWED_ORIGINS=http://localhost:8080
LEADS_WEBHOOK_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=
